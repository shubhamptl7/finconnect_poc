<%- include('../partials/header') %>

<h2 style="color: #0f172a; margin-top: 0;">Reset your password</h2>
<p>Hi <%= name %>,</p>
<p>We received a request to reset the password for your PayOman account. If you made this request, please click the button below to set a new password.</p>

<div style="text-align: center;">
  <a href="<%= url %>" class="btn" style="color: #ffffff;">Reset Password</a>
</div>

<p style="font-size: 14px; color: #64748b; margin-top: 24px;">
  <strong>Note:</strong> This link will expire in 10 minutes. If you did not request a password reset, you can safely ignore this email. Your password will remain unchanged.
</p>

<%- include('../partials/footer') %>
